include("${CMAKE_CURRENT_LIST_DIR}/cocotbTargets.cmake")

set(cocotb_gpi_FOUND TRUE)
set(cocotb_bootstrap_FOUND TRUE)

foreach(component IN LISTS cocotb_FIND_COMPONENTS)
    if(NOT cocotb_${component}_FOUND AND cocotb_FIND_REQUIRED_${component})
        set(cocotb_FOUND FALSE)
    endif()
endforeach()
